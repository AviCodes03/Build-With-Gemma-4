# Google AI Studio / Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemma Model Identifier
# Supported Gemma models available via Google AI Studio API:
# - gemma-2-27b-it (High quality, deep reasoning)
# - gemma-2-9b-it  (Fast, lightweight)
# If your challenge provides a specific Gemma 4 model endpoint, update it here:
GEMMA_MODEL_ID=gemma-2-27b-it

# Server Port
PORT=5000
